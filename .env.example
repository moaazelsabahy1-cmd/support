DATABASE_URL=postgresql://solvio:solvio@localhost:5433/solvio

BETTER_AUTH_SECRET=replace-with-a-32-character-secret-key
BETTER_AUTH_URL=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Chat and embeddings use OPENROUTER_API_KEY against https://openrouter.ai/api/v1 only.
# Do not use a direct OpenAI API key.

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=solvio_chunks

FIRECRAWL_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Solvio <noreply@solvio.local>

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_PATH=/socket.io

PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@solvio.local

WIDGET_PUBLIC_KEY=solvio-widget-dev-key
NEXT_PUBLIC_WIDGET_KEY=solvio-widget-dev-key
WIDGET_ALLOWED_ORIGINS=
# Public embed key for /ai-widget.js is stored in Postgres (default wk_dev_default).
# Do not put OPENROUTER_API_KEY in the widget script.

KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=6
KNOWLEDGE_MIN_SCORE=0.35
# Production target for AI answer vs human handoff. If unset, retrieval min score is used.
AI_KNOWLEDGE_CONFIDENCE_THRESHOLD=0.75
KNOWLEDGE_AUTO_APPROVE=false
KNOWLEDGE_MAX_FILE_BYTES=15728640

PORT=3000
HOST=localhost
NODE_ENV=development
