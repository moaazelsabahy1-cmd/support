{
  "name": "solvio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --exclude \".next\" --exclude \"node_modules\" --exclude \"uploads\" server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:ensure-handoff-agents": "tsx scripts/ensure-handoff-agents.ts",
    "db:diagnose-handoff-agents": "tsx scripts/diagnose-handoff-agents.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:mongo": "tsx scripts/migrate-mongo-to-postgres.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@mendable/firecrawl-js": "^4.37.0",
    "@prisma/client": "^6.19.2",
    "@qdrant/js-client-rest": "^1.19.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "html-to-text": "^10.0.1",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "mongodb": "^7.6.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "openai": "^7.8.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "prisma": "^6.19.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/cookie": "^0.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
